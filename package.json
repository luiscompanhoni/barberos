{
  "name": "barberos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:rules": "node scripts/verify-quality-rules.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run lint:rules && npm run typecheck && npm test && npm run build",
    "check:publicacao": "node --test scripts/publicacao/*.test.mjs",
    "check:publicacao:servidor": "npm run check:publicacao && python3 -B -m unittest discover -s scripts/publicacao -p 'test_*.py'",
    "publicacao:preparar": "node scripts/publicacao/preparar.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "push:chaves": "node scripts/gerar-chaves-push.mjs",
    "db:migrate": "prisma migrate dev",
    "db:demo": "tsx prisma/demo-historico.ts",
    "criar-dono": "tsx prisma/criar-dono.ts",
    "db:planos": "tsx prisma/planos-exemplo.ts",
    "db:produtos": "tsx --env-file=.env prisma/produtos-exemplo.ts",
    "teste:todos": "bash scripts/testes-integracao.sh",
    "teste:assinaturas": "tsx --env-file=.env scripts/teste-assinaturas.ts",
    "teste:pagarme": "tsx --env-file=.env scripts/teste-pagarme.ts",
    "teste:comandas": "tsx --env-file=.env scripts/teste-comandas.ts",
    "teste:automacoes": "tsx --env-file=.env scripts/teste-automacoes.ts",
    "teste:crescimento": "tsx --env-file=.env scripts/teste-crescimento.ts",
    "teste:login": "tsx --env-file=.env scripts/teste-login.ts",
    "teste:antecipado": "tsx --env-file=.env scripts/teste-antecipado.ts",
    "teste:agenda:cliente": "tsx --env-file=.env scripts/teste-agendamento-app-direto.ts",
    "teste:anotacoes": "tsx --env-file=.env scripts/teste-anotacoes.ts",
    "teste:avisos-etiquetas": "tsx scripts/teste-avisos-etiquetas.ts",
    "teste:jogos": "tsx --env-file=.env scripts/teste-jogos.ts",
    "teste:financeiro": "tsx --env-file=.env scripts/teste-financeiro.ts",
    "teste:historico": "tsx scripts/teste-conciliacao-historico.ts",
    "teste:agentes": "tsx scripts/teste-agentes.ts",
    "teste:estudio:templates": "tsx scripts/teste-estudio-templates.ts",
    "teste:rh": "tsx --env-file=.env scripts/teste-rh.ts",
    "teste:despesas": "tsx --env-file=.env scripts/teste-despesas.ts",
    "teste:backups": "tsx --env-file=.env scripts/teste-backups.ts",
    "teste:campanhas": "tsx --env-file=.env scripts/teste-campanhas.ts",
    "teste:checkout": "tsx --env-file=.env scripts/teste-checkout.ts",
    "teste:estorno": "tsx --env-file=.env scripts/teste-estorno.ts",
    "teste:permissoes": "tsx --env-file=.env scripts/teste-permissoes.ts",
    "teste:cancelamento": "tsx --env-file=.env scripts/teste-cancelamento.ts",
    "teste:lgpd": "tsx --env-file=.env scripts/teste-lgpd.ts",
    "teste:evolucao": "node --env-file=.env scripts/teste-evolucao.mjs",
    "teste:recrutamento:formularios": "tsx scripts/teste-recrutamento-formularios.ts",
    "teste:recrutamento:entrevistas": "tsx scripts/teste-recrutamento-entrevistas.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@date-fns/tz": "^1.5.0",
    "@prisma/client": "^6.19.3",
    "date-fns": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "motion": "14.6.0",
    "next": "^16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@prisma/config@6.19.3": { "deepmerge-ts": "8.0.2" },
    "vite": "8.3.3",
    "@typescript-eslint/typescript-estree@8.71.0": { "minimatch": "11.0.1" }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "^16.4.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
