    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "motion": "14.6.0",
    "next": "^16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
