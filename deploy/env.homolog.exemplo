# .env da HOMOLOGACAO (fica so no servidor, em /opt/barberos-homolog/.env). Nunca commitar.
# DB_SENHA e SESSION_SECRET sao gerados sozinhos na primeira subida (scripts/deploy.sh ... homolog).
# Aqui nada sai de verdade: AMBIENTE=homologacao forca WhatsApp, pagamentos e maquininha simulados.

DB_SENHA=
SESSION_SECRET=
TZ_BARBEARIA="America/Sao_Paulo"

# Endereco da homologacao (um so, para site e painel). Crie no DNS um registro A apontando para o IP do VPS.
HOMOLOG_DOMINIO="homolog.appblackbarber.com"
APP_URL="https://homolog.appblackbarber.com"
SITE_URL=
PAINEL_URL=

# Primeiro acesso (banco vazio): cria o dono. Com a copia da producao, a equipe entra com o mesmo acesso de la.
DONO_TELEFONE=
DONO_NOME=
NOME_BARBEARIA="Black Barber (homologação)"

# Codigo de acesso aparece no log: docker compose -f deploy/docker-compose.homolog.yml logs app-homolog
OTP_PROVIDER="console"

# Bot (opcional na homologacao): sem chave, as conversas vao para a equipe.
ANTHROPIC_API_KEY=

WHATSAPP_PROVIDER="simulador"
PAGAMENTOS_PROVIDER="simulado"
MAQUININHA="simulada"

# App instalável e Web Push: configure uma vez; mantenha a chave privada fora do Git.
# npm run push:chaves gera .env.push sem exibir os valores.
PUSH_PROVIDER="desativado"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="" # mailto:contato@seudominio.com ou URL https de contato
