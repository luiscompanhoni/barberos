# .env de PRODUCAO (fica so no servidor, em /opt/barberos/.env). Nunca commitar.
# DB_SENHA e SESSION_SECRET sao gerados sozinhos na primeira subida (scripts/deploy.sh).

# ---- Banco e sessao
DB_SENHA=
SESSION_SECRET=
TZ_BARBEARIA="America/Sao_Paulo"

# ---- Enderecos
# Teste so pelo IP (sem https): deixe SITE_URL/PAINEL_URL vazios, APP_URL="http://SEU-IP" e CADDY_ENDERECOS=":80"
# Com dominio apontado para o VPS (https automatico):
#   SITE_URL="https://blackbarber.com.br"
#   PAINEL_URL="https://painel.blackbarber.com.br"
#   CADDY_ENDERECOS="blackbarber.com.br, www.blackbarber.com.br, painel.blackbarber.com.br"
SITE_URL=
PAINEL_URL=
APP_URL=
CADDY_ENDERECOS=":80"

# ---- Primeiro acesso: cria o dono na primeira subida (depois pode apagar)
DONO_TELEFONE=
DONO_NOME=
NOME_BARBEARIA="Black Barber"

# ---- Login por codigo. "console" = o codigo aparece no log do servidor
# (docker compose logs app). Troque para "whatsapp" quando o WhatsApp oficial estiver ligado.
OTP_PROVIDER="console"

# ---- Bot (Claude)
ANTHROPIC_API_KEY=

# ---- WhatsApp oficial (Cloud API). Enquanto nao tiver: "simulador"
WHATSAPP_PROVIDER="simulador"
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_CODIGO=
WHATSAPP_TEMPLATE_AVISO=
WHATSAPP_NUMERO_PUBLICO=

# ---- Pagamentos das assinaturas: "simulado" ate ter as chaves da Pagar.me
PAGAMENTOS_PROVIDER="simulado"
PAGARME_SECRET_KEY=
PAGARME_PUBLIC_KEY=
PAGARME_WEBHOOK_TOKEN=
NOME_FATURA="BLACKBARBER"

# ---- Maquininha: "manual" (qualquer maquininha) ate ativar o Stone Connect
MAQUININHA="manual"
STONE_POS_SERIAL=
EMAIL_BALCAO=
