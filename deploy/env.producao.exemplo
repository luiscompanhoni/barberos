# .env de PRODUCAO (fica so no servidor, em /opt/barberos/.env). Nunca commitar.
# DB_SENHA e SESSION_SECRET sao gerados sozinhos na primeira subida (scripts/deploy.sh).

# ---- Banco e sessao
DB_SENHA=
SESSION_SECRET=
TZ_BARBEARIA="America/Sao_Paulo"

# ---- Enderecos
# Teste so pelo IP (sem https): deixe SITE_URL/PAINEL_URL vazios, APP_URL="http://SEU-IP" e CADDY_ENDERECOS=":80"
# Com dominio apontado para o VPS (https automatico):
#   SITE_URL="https://appblackbarber.com"
#   PAINEL_URL="https://painel.appblackbarber.com"
#   CADDY_ENDERECOS="appblackbarber.com, www.appblackbarber.com, painel.appblackbarber.com"
SITE_URL=
PAINEL_URL=
APP_URL=
CADDY_ENDERECOS=":80"
# Endereco antigo do painel (depois de trocar de dominio): quem entrar por ele vai para o PAINEL_URL.
# CADDY_PAINEL_ANTIGO="painel.179-236-244-156.sslip.io"
# IP do servidor: quem digitar so o IP (http ou https) vai para o painel. Vazio = desligado.
CADDY_IP=

# ---- Bot do WhatsApp: nome de quem atende a recepcao (o bot fala em nome dele). Vazio = "atendimento da barbearia".
# BOT_NOME_ATENDENTE="Leonel"

# ---- Primeiro acesso: cria o dono na primeira subida (depois pode apagar)
DONO_TELEFONE=
DONO_NOME=
NOME_BARBEARIA="Black Barber"

# ---- Login por codigo. "console" = o codigo aparece no log do servidor
# (docker compose logs app). Troque para "whatsapp" quando o WhatsApp (oficial ou nao) estiver ligado.
OTP_PROVIDER="console"

# ---- Bot (Claude)
ANTHROPIC_API_KEY=

# ---- WhatsApp: tres modos
#   "evolution" = nao oficial, conecta o numero pelo QR code (tela WhatsApp do painel). Precisa de
#                 COMPOSE_PROFILES="evolution" (sobe o servico) e EVOLUTION_API_KEY (gerada pelo deploy).
#   "cloud"     = oficial da Meta (Cloud API): preencha as variaveis WHATSAPP_* abaixo.
#   "simulador" = nada sai do servidor (teste).
WHATSAPP_PROVIDER="simulador"
COMPOSE_PROFILES=
EVOLUTION_API_KEY=
# Oficial (Cloud API):
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_CODIGO=
WHATSAPP_TEMPLATE_AVISO=
WHATSAPP_NUMERO_PUBLICO=

# ---- Pagamentos das assinaturas: "simulado" | "celcash" | "pagarme" | "asaas"
PAGAMENTOS_PROVIDER="simulado"
# Celcash (cel_payments): Galax ID e Galax Hash em Modulos > Webservice. Libere o IP do servidor la.
# Webhook na Celcash: https://PAINEL/api/pagamentos/celcash/webhook?token=<CELCASH_WEBHOOK_TOKEN>
# CELCASH_WEBHOOK_HASH = confirmHash que a Celcash mostra ao salvar o webhook.
CELCASH_AMBIENTE="producao"
CELCASH_GALAX_ID=
CELCASH_GALAX_HASH=
CELCASH_WEBHOOK_TOKEN=
CELCASH_WEBHOOK_HASH=
PAGARME_SECRET_KEY=
PAGARME_PUBLIC_KEY=
PAGARME_WEBHOOK_TOKEN=
NOME_FATURA="BLACKBARBER"
# Endereco de cobranca do cartao (a Pagar.me exige; usa o da barbearia)
COBRANCA_ENDERECO="50, Rua 15 de Abril, Centro"
COBRANCA_CEP="89160161"
COBRANCA_CIDADE="Rio do Sul"
COBRANCA_UF="SC"

# ---- Maquininha: "manual" (qualquer maquininha) ate ativar o Stone Connect
MAQUININHA="manual"
STONE_POS_SERIAL=
EMAIL_BALCAO=

# ---- Backup (container "backup"): todo dia na BACKUP_HORA, restauracao de teste e 14 dias em /opt/barberos/backups.
# Copia FORA do servidor (recomendado): um bucket S3 (Backblaze B2, Cloudflare R2, AWS...). O arquivo sobe
# criptografado com BACKUP_SENHA: guarde essa senha FORA do servidor (sem ela, a copia nao abre).
BACKUP_HORA="0300"
BACKUP_SENHA=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGIAO="auto"
BACKUP_S3_PROVEDOR="Other"
BACKUP_S3_CHAVE=
BACKUP_S3_SEGREDO=

# App instalável e Web Push: configure uma vez; mantenha a chave privada fora do Git.
# npm run push:chaves gera .env.push sem exibir os valores.
PUSH_PROVIDER="desativado"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="" # mailto:contato@seudominio.com ou URL https de contato
