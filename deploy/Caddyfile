{
	# Acesso pelo IP chega sem nome (SNI): usa o certificado do IP.
	default_sni {$CADDY_SNI}
}

# Enderecos vem do .env (CADDY_ENDERECOS):
# - so IP, para testar:  :80
# - com dominio (https automatico pelo Let's Encrypt):
#   appblackbarber.com, www.appblackbarber.com, painel.appblackbarber.com
{$CADDY_ENDERECOS} {
	encode zstd gzip
	reverse_proxy app:3000
}

# Endereco antigo do painel (CADDY_PAINEL_ANTIGO no .env, ex.: o provisorio sslip.io) vai para o novo.
# A API continua atendendo nele: webhooks cadastrados no endereco antigo (Pagar.me, Celcash) nao seguem
# redirecionamento e falhariam.
{$CADDY_PAINEL_ANTIGO} {
	handle /api/* {
		reverse_proxy app:3000
	}
	handle {
		redir {$CADDY_IP_DESTINO}{uri}
	}
}

# Quem digita so o IP do servidor (CADDY_IP no .env) vai para o painel. O Let's Encrypt
# emite certificado de IP so no perfil "shortlived" (6 dias, o Caddy renova sozinho).
{$CADDY_IP} {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	redir {$CADDY_IP_DESTINO}{uri}
}

# Sites extras gravados no servidor (ex.: a homologacao, criada por "scripts/deploy.sh ... homolog").
# Sem arquivo nenhum, nao faz nada.
import /etc/caddy/sites/*.caddy
