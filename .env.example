DATABASE_URL="postgresql://barberos:barberos@localhost:5433/barberos"
# Segredo para assinar a sessao (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET="troque-este-segredo-em-producao-com-32-bytes-ou-mais"
TZ_BARBEARIA="America/Sao_Paulo"

# Codigo de login: "console" (teste local, aparece na tela) ou "whatsapp" (producao)
OTP_PROVIDER="console"

# ---- Bot (Claude) ----
# Chave da API da Anthropic (console.anthropic.com). Sem ela o bot passa as conversas para a equipe.
ANTHROPIC_API_KEY=""
# Modelo do bot. Padrao: claude-opus-5-5 (effort baixo). Alternativa mais barata: claude-haiku-4-5
# BOT_MODELO="claude-opus-5-5"

# ---- WhatsApp ----
# "simulador" (teste, sem Meta; use a tela /simulador), "cloud" (WhatsApp Cloud API oficial)
# ou "evolution" (nao oficial, conecta pelo QR code na tela WhatsApp do painel)
WHATSAPP_PROVIDER="simulador"
# Dados do app na Meta (developers.facebook.com > WhatsApp > Configuracao da API)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
# Texto que voce escolhe e cadastra na Meta ao configurar o webhook
WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_API_VERSION="v23.0"
# Templates aprovados na Meta:
#  - codigo de acesso (categoria Autenticacao, com botao copiar codigo)
WHATSAPP_TEMPLATE_CODIGO=""
#  - aviso de agendamento (categoria Utilidade), corpo: "Ola {{1}}! {{2}}"
WHATSAPP_TEMPLATE_AVISO=""
# Nao oficial (Evolution API). Em producao o deploy/docker-compose.yml ja preenche URL e chave.
# EVOLUTION_URL="http://localhost:8080"
# EVOLUTION_API_KEY=""
# EVOLUTION_INSTANCIA="barberos"
# EVOLUTION_WEBHOOK_URL="http://app:3000/api/whatsapp/evolution"

# ---- Assinaturas / pagamentos ----
# "simulado" (teste local), "pagarme" (Stone), "celcash" ou "asaas"
PAGAMENTOS_PROVIDER="simulado"
# Asaas: chave da API (Integracoes > Chave de API) e ambiente ("sandbox" ou "producao")
ASAAS_API_KEY=""
ASAAS_AMBIENTE="sandbox"
# Token que voce define ao cadastrar o webhook no Asaas (URL: https://painel.appblackbarber.com/api/pagamentos/webhook)
ASAAS_WEBHOOK_TOKEN=""
# Enderecos publicos. SITE_URL = pagina de venda + area do cliente + links de pagamento;
# PAINEL_URL = sistema da equipe. Em producao: https://appblackbarber.com e https://painel.appblackbarber.com
# No computador: localhost:3000 (site) e painel.localhost:3000 (painel). Sem PAINEL_URL tudo fica num endereco so.
SITE_URL="http://localhost:3000"
PAINEL_URL="http://painel.localhost:3000"
# Padrao para os dois quando SITE_URL/PAINEL_URL nao estao definidos (compatibilidade)
APP_URL="http://localhost:3000"

# Pagar.me (grupo Stone) - PAGAMENTOS_PROVIDER="pagarme"
# Chaves em dash.pagar.me > Configuracoes > Chaves (use as de teste sk_test_/pk_test_ primeiro)
PAGARME_SECRET_KEY=""
PAGARME_PUBLIC_KEY=""
# Token que voce inventa; a URL do webhook fica:
#   https://painel.appblackbarber.com/api/pagamentos/pagarme/webhook?token=ESTE_TOKEN
PAGARME_WEBHOOK_TOKEN=""
# Nome que aparece na fatura do cartao (ate 13 letras)
NOME_FATURA="BARBEARIA"
# Endereco de cobranca do cartao (a Pagar.me exige; usa o da barbearia).
COBRANCA_ENDERECO=""
COBRANCA_CEP=""
COBRANCA_CIDADE=""
COBRANCA_UF=""

# Celcash (cel_payments): Galax ID e Galax Hash em Modulos > Webservice ("sandbox" ou "producao").
# Webhook: https://painel.appblackbarber.com/api/pagamentos/celcash/webhook?token=CELCASH_WEBHOOK_TOKEN
# CELCASH_WEBHOOK_HASH = confirmHash que a Celcash mostra ao salvar o webhook.
CELCASH_AMBIENTE="sandbox"
CELCASH_GALAX_ID=""
CELCASH_GALAX_HASH=""
CELCASH_WEBHOOK_TOKEN=""
CELCASH_WEBHOOK_HASH=""

# Numero do WhatsApp mostrado na pagina de venda (/assine), com DDI+DDD. Ex.: 5547999998888
WHATSAPP_NUMERO_PUBLICO=""

# ---- Fase 4: comanda e maquininha
# manual = registra o que passou em qualquer maquininha | simulada = teste | stone = Stone Connect 2.0 (Pagar.me)
# (vazio: simulada no computador, manual em producao)
MAQUININHA=""
# Numero de serie da maquininha S920/Q92 ativada no Connect 2.0 (so no modo stone).
# Varias maquininhas: separe por virgula; STONE_POS_NOMES (opcional) da os nomes na mesma ordem.
STONE_POS_SERIAL=""
STONE_POS_NOMES=""
# E-mail usado nos pedidos da maquininha quando o cliente nao tem e-mail cadastrado
EMAIL_BALCAO=""
