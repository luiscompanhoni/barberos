DATABASE_URL="postgresql://barberos:barberos@localhost:5433/barberos"
# Segredo para assinar a sessao (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET="troque-este-segredo-em-producao-com-32-bytes-ou-mais"
TZ_BARBEARIA="America/Sao_Paulo"

# Codigo de login: "console" (teste local, aparece na tela) ou "whatsapp" (producao)
OTP_PROVIDER="console"

# Login social do cliente. Sem credenciais, os botões ficam indisponíveis.
# Cadastre os retornos de SITE_URL conforme docs/login-social-cadastro.md.
AUTH_GOOGLE_CLIENT_ID=""
AUTH_GOOGLE_CLIENT_SECRET=""
AUTH_FACEBOOK_CLIENT_ID=""
AUTH_FACEBOOK_CLIENT_SECRET=""
AUTH_FACEBOOK_API_VERSION=""
AUTH_APPLE_CLIENT_ID=""
AUTH_APPLE_CLIENT_SECRET=""

# ---- Bot (Claude) ----
# Chave da API da Anthropic (console.anthropic.com). Sem ela o bot passa as conversas para a equipe.
ANTHROPIC_API_KEY=""
# Modelo do bot. Padrao: claude-opus-5-5 (effort baixo). Alternativa mais barata: claude-haiku-4-5
# BOT_MODELO="claude-opus-5-5"
# Mídia somente com transcritor privado preparado e teste acompanhado.
WHATSAPP_MIDIA_ATIVA=false
BOT_TRANSCRICAO_URL=""
BOT_TRANSCRICAO_TOKEN=""

# ---- WhatsApp ----
# "simulador" (teste, sem Meta; use a tela /simulador), "cloud" (WhatsApp Cloud API oficial)
# ou "evolution" (nao oficial, conecta pelo QR code na tela WhatsApp do painel)
WHATSAPP_PROVIDER="simulador"
# Dados do app na Meta (developers.facebook.com > WhatsApp > Configuracao da API)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
# Texto que voce escolhe e cadastra na Meta ao configurar o webhook
WHATSAPP_VERIFY_TOKEN=""
# Cadastro incorporado (botao "Conectar com o Facebook" em WhatsApp): id do app e da configuracao
# do Login do Facebook para Empresas. Sem os dois o botao nao aparece.
WHATSAPP_APP_ID=""
WHATSAPP_ES_CONFIG_ID=""
# WHATSAPP_API_VERSION="v23.0"

# Recepção multimodal: desligada por padrão. Não substitui a autorização de IA paga.
WHATSAPP_MIDIA_ATIVA="false"
# Worker local autenticado; nunca publicar a porta na Internet.
BOT_TRANSCRICAO_URL="http://127.0.0.1:8091/transcrever"
BOT_TRANSCRICAO_TOKEN=""
# Templates aprovados na Meta:
#  - codigo de acesso (categoria Autenticacao, com botao copiar codigo)
WHATSAPP_TEMPLATE_CODIGO=""
#  - aviso de agendamento (categoria Utilidade), corpo: "Ola {{1}}! {{2}}"
WHATSAPP_TEMPLATE_AVISO=""
# Nao oficial (Evolution API). Em producao o deploy/docker-compose.yml ja preenche URL e chave.
# EVOLUTION_URL="http://localhost:8080"
# EVOLUTION_API_KEY=""
# EVOLUTION_INSTANCIA="barberos"
# EVOLUTION_WEBHOOK_URL="http://app:3000/api/whatsapp/evolution"

# ---- Assinaturas / pagamentos ----
# "simulado" (teste local), "pagarme" (Stone), "celcash" ou "asaas"
PAGAMENTOS_PROVIDER="simulado"
# Asaas: chave da API (Integracoes > Chave de API) e ambiente ("sandbox" ou "producao")
ASAAS_API_KEY=""
ASAAS_AMBIENTE="sandbox"
# Token que voce define ao cadastrar o webhook no Asaas (URL: https://painel.appblackbarber.com/api/pagamentos/webhook)
ASAAS_WEBHOOK_TOKEN=""
# Enderecos publicos. SITE_URL = pagina de venda + area do cliente + links de pagamento;
# PAINEL_URL = sistema da equipe. Em producao: https://appblackbarber.com e https://painel.appblackbarber.com
# Indicação nova: ativar só após deploy completo, orçamento aprovado e homologação de cobrança.
# Teto agregado comprometido: cada indicação registra R$ 30, inclusive créditos ainda não usados.
INDICACAO_ASSINATURA_V2_ATIVA=false
INDICACAO_ASSINATURA_LIMITE_CENTAVOS=0
CREDITOS_MENSALIDADE_ATIVOS=false
# Acesso único: mesmo host no computador; em produção, site e subdomínio HTTPS configurados acima.
SITE_URL="http://localhost:3000"
PAINEL_URL="http://localhost:3000"
# Padrao para os dois quando SITE_URL/PAINEL_URL nao estao definidos (compatibilidade)
APP_URL="http://localhost:3000"

# Pagar.me (grupo Stone) - PAGAMENTOS_PROVIDER="pagarme"
# Chaves em dash.pagar.me > Configuracoes > Chaves (use as de teste sk_test_/pk_test_ primeiro)
PAGARME_SECRET_KEY=""
PAGARME_PUBLIC_KEY=""
# Token que voce inventa; a URL do webhook fica:
#   https://painel.appblackbarber.com/api/pagamentos/pagarme/webhook?token=ESTE_TOKEN
PAGARME_WEBHOOK_TOKEN=""
# Nome que aparece na fatura do cartao (ate 13 letras)
NOME_FATURA="BARBEARIA"
# Endereco de cobranca do cartao (a Pagar.me exige; usa o da barbearia).
COBRANCA_ENDERECO=""
COBRANCA_CEP=""
COBRANCA_CIDADE=""
COBRANCA_UF=""

# Celcash (cel_payments): Galax ID e Galax Hash em Modulos > Webservice ("sandbox" ou "producao").
# Webhook: https://painel.appblackbarber.com/api/pagamentos/celcash/webhook?token=CELCASH_WEBHOOK_TOKEN
# CELCASH_WEBHOOK_HASH = confirmHash que a Celcash mostra ao salvar o webhook.
CELCASH_AMBIENTE="sandbox"
CELCASH_GALAX_ID=""
CELCASH_GALAX_HASH=""
CELCASH_WEBHOOK_TOKEN=""
CELCASH_WEBHOOK_HASH=""

# Numero do WhatsApp mostrado na pagina de venda (/assine), com DDI+DDD. Ex.: 5547999998888
WHATSAPP_NUMERO_PUBLICO=""

# ---- Fase 4: comanda e maquininha
# manual = registra o que passou em qualquer maquininha | simulada = teste | stone = Stone Connect 2.0 (Pagar.me)
# (vazio: simulada no computador, manual em producao)
MAQUININHA=""
# Numero de serie da maquininha S920/Q92 ativada no Connect 2.0 (so no modo stone).
# Varias maquininhas: separe por virgula; STONE_POS_NOMES (opcional) da os nomes na mesma ordem.
STONE_POS_SERIAL=""
STONE_POS_NOMES=""
# E-mail usado nos pedidos da maquininha quando o cliente nao tem e-mail cadastrado
EMAIL_BALCAO=""

# App instalável e Web Push: configure uma vez; mantenha a chave privada fora do Git.
# npm run push:chaves gera .env.push sem exibir os valores.
PUSH_PROVIDER="desativado"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="" # mailto:contato@seudominio.com ou URL https de contato

# Central de agentes: somente barbearia; não habilita envio, publicação ou movimentação financeira.
AGENTES_HABILITADOS="false"
# Habilitar conscientemente: usa ANTHROPIC_API_KEY e BOT_MODELO existentes, com consumo de IA.
AGENTES_EXECUCAO_ATIVA="false"
# Leitura Meta: conta autorizada, versão suportada validada e token protegido com ads_read.
META_ADS_ACCOUNT_ID=""
META_ADS_API_VERSION=""
META_ADS_TOKEN=""

# Entrevistas: transporte WhatsApp separado, sem IA. Ativar somente após autorização de envios.
RECRUTAMENTO_ENTREVISTAS_WHATSAPP_ATIVO=false

# Interface de piloto restrito (não inicia teste nem permite envio por si só).
WHATSAPP_PILOTO_ENTREVISTAS_HABILITADO=false
# Teste acompanhado: responde apenas a DONO/GERENTE ativos no cadastro.
# Reutiliza ANTHROPIC_API_KEY e BOT_MODELO existentes, com consumo de IA nos testes.
# Campanhas/templates permanecem bloqueados. Exige botAtivo na configuração.
WHATSAPP_ATENDIMENTO_TESTE_EQUIPE=false

# Mensalidades: preparar e conferir antes de habilitar o envio real. Não enviar o histórico inteiro.
COBRANCA_AUTOMATICA_WHATSAPP_ATIVA=false
# Evita duas rotinas de cobrança ao mesmo tempo: não ligar ambas.
COBRANCA_LEGADA_WHATSAPP_ATIVA=false
# Data inicial de vencimentos elegíveis (AAAA-MM-DD); vazio mantém a rotina bloqueada.
COBRANCA_AUTOMATICA_DESDE=""
# Hosts externos de pagamento previamente conferidos, separados por vírgula (sem protocolo).
COBRANCA_AUTOMATICA_LINK_HOSTS=""
